# Set the canonical public origin when a domain is approved.
NEXT_PUBLIC_SITE_URL=

# Keep false by default; set true only for an approved public production release.
PUBLICATION_APPROVED=false

# PostgreSQL connection placeholder. Replace before running database commands.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Generate at least 32 random bytes before enabling admin login.
AUTH_SECRET=

# Supply these only to the one-time admin bootstrap command via a secret manager.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Configure transactional email before activating server-side notifications.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Configure private object storage before accepting CV uploads.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
